# ---------------------------------------------------------------------------
# PlacementPilot AI — local environment
# Copy to .env.local for overrides. Never commit real keys.
# ---------------------------------------------------------------------------

# Database. SQLite by default so the app runs with zero external services.
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use
# DATABASE_URL="postgresql://user:pass@localhost:5432/placementpilot"
DATABASE_URL="file:./dev.db"

# Session signing secret. Replace with a long random string in production.
AUTH_SECRET="dev-only-secret-change-me-to-a-long-random-string-please-0123456789"

# ---------------------------------------------------------------------------
# AI provider (optional). Without a key the app runs in Demo Mode: every AI
# feature still works using the deterministic on-device generators, and the UI
# labels the output as demo content rather than pretending a model ran.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=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
# OPENAI_BASE_URL=                # for OpenAI-compatible providers

# ---------------------------------------------------------------------------
# Code execution (optional). Without it the coding editor runs in
# practice-only mode and says so — it never fabricates run results.
# Judge0 (self-hosted or RapidAPI): https://judge0.com
# ---------------------------------------------------------------------------
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=
# JUDGE0_HOST=judge0-ce.p.rapidapi.com
